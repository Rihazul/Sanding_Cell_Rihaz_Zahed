{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask Debug (uv)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_APP": "flask_app.py",
                "FLASK_DEBUG": "1",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "run",
                "--no-reload",
                "--host", "0.0.0.0",
                "--port", "5100",
                "--with-threads"
            ],
            "justMyCode": false,
            "subProcess": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Flask App Direct",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/flask_app.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "subProcess": true,
            "debugOptions": [
                "redirectOutput"
            ]
        },
        {
  "name": "move_s_spiral_test (--run)",
  "type": "python",
  "request": "launch",
  "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "program": "${workspaceFolder}\\ytests\\move_s_spiral_test.py",
  "args": ["--run"],
  "cwd": "${workspaceFolder}",
  "justMyCode": false,
  "subProcess": true,
  "console": "integratedTerminal",
  "debugOptions": ["redirectOutput"]
}

    ]
}